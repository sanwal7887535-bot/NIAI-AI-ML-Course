    "# Given to you: a small plotting helper. Read it, you do not need to change it.\n",
    "\n",
    "def show(matrices, titles, lim=4):\n",
    "    \"\"\"Draw what each matrix does to a grid and to the unit square.\"\"\"\n",
    "    fig, axes = plt.subplots(1, len(matrices), figsize=(3.4 * len(matrices), 3.4))\n",
    "    axes = np.atleast_1d(axes)\n",
    "    square = np.array([[0, 1, 1, 0, 0], [0, 0, 1, 1, 0]], dtype=float)\n",
    "    for ax, M, title in zip(axes, matrices, titles):\n",
    "        M = np.asarray(M, dtype=float)\n",
    "        for k in np.linspace(-lim, lim, 9):\n",
    "            t = np.linspace(-lim, lim, 60)\n",
    "            for line in (np.stack([np.full_like(t, k), t]),\n",
    "                         np.stack([t, np.full_like(t, k)])):\n",
    "                p = M @ line\n",
    "                ax.plot(p[0], p[1], color=\"#c9ced4\", lw=.8)\n",
    "        s = M @ square\n",
    "        ax.plot(s[0], s[1], color=\"#d1495b\", lw=2)\n",
    "        for vec, col in [(M @ [1, 0], \"#3b6ea5\"), (M @ [0, 1], \"#2a9d8f\")]:\n",
    "            ax.annotate(\"\", xy=vec, xytext=(0, 0),\n",
    "                        arrowprops=dict(arrowstyle=\"-|>\", color=col, lw=2))\n",
    "        ax.set_xlim(-lim, lim); ax.set_ylim(-lim, lim); ax.set_aspect(\"equal\")\n",
    "        ax.axhline(0, color=\"#555\", lw=.8); ax.axvline(0, color=\"#555\", lw=.8)\n",
    "        ax.set_xticks([]); ax.set_yticks([])\n",
    "        ax.set_title(f\"{title}\\\\ndet = {np.linalg.det(M):.2f}\", fontsize=9.5)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "print(\"helper ready\")"
   ]
