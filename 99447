    "from scipy import ndimage\n",
    "\n",
    "def letter_F(n=64):\n",
    "    \"\"\"The traditional test shape: you can always tell if it has been mirrored.\"\"\"\n",
    "    img = np.zeros((n, n))\n",
    "    img[8:56, 14:22] = 1.0    # spine\n",
    "    img[8:16, 14:48] = 1.0    # top bar\n",
    "    img[28:35, 14:40] = 1.0   # middle bar\n",
    "    return img\n",
    "\n",
    "\n",
    "def apply_to_image(img, M):\n",
    "    \"\"\"Warp an image by M about its centre.\n",
    "\n",
    "    ndimage wants the INVERSE map, output pixel -> input pixel. That is not a\n",
    "    quirk: mapping forwards leaves gaps, so imaging libraries work backwards\n",
    "    from each destination pixel and ask where it came from.\n",
    "    \"\"\"\n",
    "    centre = np.array(img.shape) / 2.0\n",
    "    Minv = np.linalg.inv(M)\n",
    "    return ndimage.affine_transform(img, Minv,\n",
    "                                    offset=centre - Minv @ centre, order=1)\n",
    "\n",
    "\n",
    "img = letter_F()\n",
    "print(\"one grayscale image:\", img.shape, \"  ndim =\", img.ndim)\n",
